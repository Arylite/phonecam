#include <windows.h>
#include "version.h"

1 ICON "phonecam.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION PHONECAM_VERSION_NUMBERS
PRODUCTVERSION PHONECAM_VERSION_NUMBERS
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "PhoneCam"
            VALUE "ProductName", "PhoneCam"
            VALUE "FileVersion", PHONECAM_VERSION
            VALUE "ProductVersion", PHONECAM_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
